# TraceGuard — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Sanity Content Lake ───────────────────────────────────────────────────────
# Get these from https://www.sanity.io/manage → your project
SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_sanity_api_token_here

# ── AI Provider ───────────────────────────────────────────────────────────────
# Recommended: Google Gemini (used in production)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash

# Alternative: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20241022

# ── Credential Encryption ─────────────────────────────────────────────────────
# REQUIRED for cloud account scanning. AES-256-GCM master key (32 bytes as hex).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret — rotate it if ever compromised.
CREDENTIAL_ENCRYPTION_KEY=

# ── AWS (optional — for env-mode accounts or testing without UI) ──────────────
# These are only used if credentialMode='env' for an account, or for testing.
# For production multi-tenant use, leave these empty and use encrypted accounts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ── GCP (optional — for env-mode accounts or testing) ────────────────────────
# Paste your GCP service account JSON as a single-line string (escape newlines).
GCP_SERVICE_ACCOUNT_JSON=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
